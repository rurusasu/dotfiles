#!/bin/sh
set -eu

if [ "$#" -eq 3 ] && [ "$1" = signin ] && [ "$2" = --account ] && \
	[ "$3" = my.1password.com ]; then
	printf 'acceptance-session\n'
	exit 0
fi

if [ "$#" -eq 4 ] && [ "$1" = --account ] && \
	[ "$2" = my.1password.com ] && [ "$3" = read ]; then
	if [ "$4" = 'op://openclaw/3bgd5qtytxuvuauauyqr2p4iki/credential' ]; then
		printf 'acceptance-hermes-service-account-token\n'
		exit 0
	fi
	printf 'acceptance op fixture rejected reference: %s\n' "$4" >&2
	exit 2
fi

if [ "$#" -ne 9 ] || [ "$1" != item ] || [ "$2" != get ] || \
	[ "$4" != --account ] || [ "$5" != my.1password.com ] || \
	[ "$6" != --vault ] || \
	[ "$8" != --format ] || [ "$9" != json ]; then
	printf 'acceptance op fixture rejected unsupported arguments\n' >&2
	exit 2
fi

case "$3" in
"Google Calendar MCP")
	if [ "$7" != Private ]; then
		printf 'acceptance op fixture rejected vault: %s\n' "$7" >&2
		exit 2
	fi
	cat <<'JSON'
{"id":"acceptance-Google Calendar MCP","fields":[{"label":"oauth_credentials_json","value":"{\"installed\":{\"client_id\":\"acceptance-client-id\",\"client_secret\":\"acceptance-client-secret\"}}"},{"label":"tokens_json","value":"{\"accounts\":{\"shared\":{\"refresh_token\":\"acceptance-refresh-token\"}}}"}]}
JSON
	exit 0
	;;
"Hermes Agent Dashboard" | \
	"GitHubUsedOpenClawPAT" | \
	"SlackBot-OpenClaw" | \
	"SlackBot-Rick" | \
	"SlackBot-Hoffman" | \
	"SlackBot-Risarisa" | \
	"SlackBot-Nancy")
	if [ "$7" != openclaw ]; then
		printf 'acceptance op fixture rejected vault: %s\n' "$7" >&2
		exit 2
	fi
	;;
"Hermes X API MCP")
	if [ "$7" != openclaw ]; then
		printf 'acceptance op fixture rejected vault: %s\n' "$7" >&2
		exit 2
	fi
	printf '{"id":"acceptance-Hermes X API MCP","fields":[{"label":"X_API_CLIENT_ID","value":"acceptance-x-api-client-id"},{"label":"X_API_CLIENT_SECRET","value":"acceptance-x-api-client-secret"}]}\n'
	exit 0
	;;
*)
	printf 'acceptance op fixture rejected item: %s\n' "$3" >&2
	exit 2
	;;
esac

printf '{"id":"acceptance-%s","fields":[]}\n' "$3"
