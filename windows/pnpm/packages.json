{
  "$schema": "https://json.schemastore.org/package.json",
  "description": "pnpm global packages to install on Windows",
  "globalPackages": [
    {
      "installArgs": [
        "--allow-build=@deepseek-ai/dsh-subprocess-local",
        "--allow-build=@google/genai",
        "--allow-build=koffi",
        "--allow-build=protobufjs",
        "--allow-build=!node-pty"
      ],
      "name": "@deepseek-ai/dsh",
      "verifyCommand": {
        "args": ["--version"],
        "command": "dsh"
      }
    },
    {
      "installFeature": "WithHermes",
      "name": "@playwright/cli@0.1.21",
      "verifyCommand": {
        "args": ["--version"],
        "command": "playwright-cli"
      }
    },
    {
      "installFeature": "WithHermes",
      "name": "playwright@1.63.0",
      "postInstallCommand": {
        "args": ["install", "chromium"],
        "command": "playwright",
        "timeoutSeconds": 3600
      },
      "verifyCommand": {
        "args": ["--version"],
        "command": "playwright"
      }
    },
    {
      "installArgs": ["--allow-build=@github/keytar", "--allow-build=!node-pty"],
      "name": "@google/gemini-cli",
      "verifyCommand": {
        "args": ["--version"],
        "command": "gemini"
      }
    }
  ]
}
