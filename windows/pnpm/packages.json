{
  "$schema": "https://json.schemastore.org/package.json",
  "description": "pnpm global packages to install on Windows",
  "globalPackages": [
    {
      "name": "@prisma/language-server",
      "verifyCommand": {
        "args": ["--version"],
        "command": "prisma-language-server"
      }
    },
    {
      "installArgs": [
        "--allow-build=@deepseek-ai/dsh-subprocess-local",
        "--allow-build=@google/genai",
        "--allow-build=koffi",
        "--allow-build=node-pty",
        "--allow-build=protobufjs"
      ],
      "name": "@deepseek-ai/dsh",
      "verifyCommand": {
        "args": ["--version"],
        "command": "dsh"
      }
    },
    {
      "installFeature": "WithHermes",
      "name": "@playwright/cli@0.1.14",
      "verifyCommand": {
        "args": ["--version"],
        "command": "playwright-cli"
      }
    },
    {
      "installFeature": "WithHermes",
      "name": "playwright@1.61.0",
      "postInstallCommand": {
        "args": ["install", "chromium"],
        "command": "playwright",
        "timeoutSeconds": 600
      },
      "verifyCommand": {
        "args": ["--version"],
        "command": "playwright"
      }
    },
    {
      "name": "typescript-language-server",
      "verifyCommand": {
        "args": ["--version"],
        "command": "typescript-language-server"
      }
    },
    {
      "name": "typescript",
      "verifyCommand": {
        "args": ["--version"],
        "command": "tsc"
      }
    },
    {
      "installArgs": ["--allow-build=@github/keytar", "--allow-build=node-pty"],
      "name": "@google/gemini-cli",
      "verifyCommand": {
        "args": ["--version"],
        "command": "gemini"
      }
    }
  ]
}
