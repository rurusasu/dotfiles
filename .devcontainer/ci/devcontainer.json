{
  "name": "dotfiles CI",
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/nix:1.3.1": {
      "version": "2.34.8",
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "postCreateCommand": "bash ${containerWorkspaceFolder}/bootstrap.sh",
  "remoteUser": "root"
}
