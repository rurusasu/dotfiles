{{ if eq .chezmoi.os "windows" -}}
# Deploy the Windows WezTerm configuration.
# hash: {{ include "terminals/wezterm/wezterm.lua" | sha256sum }}

$ErrorActionPreference = "Stop"

$destination = Join-Path $env:USERPROFILE ".config/wezterm/wezterm.lua"
$destinationDirectory = Split-Path -Parent $destination
New-Item -ItemType Directory -Path $destinationDirectory -Force | Out-Null
@'
{{ include "terminals/wezterm/wezterm.lua" }}
'@ | Set-Content -LiteralPath $destination -Encoding UTF8 -NoNewline

Write-Host "Deployed WezTerm configuration: $destination"
{{ end -}}
