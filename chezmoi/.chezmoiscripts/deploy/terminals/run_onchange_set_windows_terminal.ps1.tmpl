{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
if (-not (Get-AppxPackage -Name Microsoft.IntelligentTerminal -ErrorAction Stop)) {
    throw 'Install Microsoft.IntelligentTerminal from chezmoi/winget/packages.json before applying terminal settings.'
}
$path = 'HKCU:\Console\%%Startup'
if (-not (Test-Path -LiteralPath $path)) { New-Item -Path $path | Out-Null }
# Console and terminal host extensions declared by the Intelligent Terminal AppX manifest.
New-ItemProperty -LiteralPath $path -Name DelegationConsole -PropertyType String -Value '{7ABAC0AD-3AEF-4556-ABE7-C1812594E071}' -Force | Out-Null
New-ItemProperty -LiteralPath $path -Name DelegationTerminal -PropertyType String -Value '{ECC17785-94ED-4359-B545-0472B7D0275F}' -Force | Out-Null
{{ end -}}
