{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Deploy terminal configurations for Linux/macOS
# hash: {{ include "terminals/wezterm/wezterm.lua" | sha256sum }}{{ include "terminals/ghostty/config" | sha256sum }}

set -euo pipefail

HOME_DIR="${HOME:-/home/$(whoami)}"

deploy_content() {
  local content="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  printf '%s\n' "$content" > "$dst"
  echo "Deployed: $dst"
}

echo "Deploying terminal configurations..."

deploy_content "$(cat <<'EOF'
{{ includeTemplate "terminals/wezterm/wezterm.lua" . }}
EOF
)" "$HOME_DIR/.config/wezterm/wezterm.lua"
deploy_content "$(cat <<'EOF'
{{ includeTemplate "terminals/ghostty/config" . }}
EOF
)" "${XDG_CONFIG_HOME:-$HOME_DIR/.config}/ghostty/config"

echo "Terminal configurations deployed."
{{ end -}}
