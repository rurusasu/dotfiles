{{ if eq .chezmoi.os "windows" -}}
# Read the committed Nix export; Windows apply does not evaluate Nix.
$desktopContractJson = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ include "../nix/home/keybindings/generated.json" | b64enc }}'))
$desktopActionScript = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ include "../scripts/powershell/Invoke-DesktopAction.ps1" | b64enc }}'))
$desktopDirectory = Join-Path $env:LOCALAPPDATA 'dotfiles/keybindings'
$desktopActionPath = Join-Path $desktopDirectory 'Invoke-DesktopAction.ps1'
[IO.Directory]::CreateDirectory($desktopDirectory) | Out-Null

function Write-DesktopManagedFile {
    param([string]$Path, [string]$Content, [bool]$ByteOrderMark)
    $encoding = New-Object Text.UTF8Encoding($ByteOrderMark)
    $bytes = @($encoding.GetPreamble()) + @($encoding.GetBytes($Content))
    if ((Test-Path -LiteralPath $Path -PathType Leaf) -and
        [Convert]::ToBase64String([IO.File]::ReadAllBytes($Path)) -ceq [Convert]::ToBase64String([byte[]]$bytes)) { return }
    $temporary = Join-Path (Split-Path -Parent $Path) ([guid]::NewGuid().ToString() + '.tmp')
    try {
        [IO.File]::WriteAllBytes($temporary, [byte[]]$bytes)
        Move-Item -LiteralPath $temporary -Destination $Path -Force
    }
    finally {
        if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force }
    }
}

Write-DesktopManagedFile $desktopActionPath $desktopActionScript $true
Write-DesktopManagedFile (Join-Path $desktopDirectory 'keybindings.json') $desktopContractJson $false

& {
{{ include "../scripts/powershell/Sync-PowerToysKeyboard.ps1" }}
} -ContractJson $desktopContractJson -ActionScriptPath $desktopActionPath -RestartPowerToys
{{ end -}}
