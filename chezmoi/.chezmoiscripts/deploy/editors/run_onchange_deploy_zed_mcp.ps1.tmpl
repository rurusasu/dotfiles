{{- if eq .chezmoi.os "windows" }}
# chezmoi:template:hash={{ include ".chezmoidata/mcp_servers.yaml" | sha256sum }}

$settingsPath = Join-Path $env:APPDATA "Zed\settings.json"
if (-not (Test-Path $settingsPath)) {
    Write-Host "[zed-mcp] Zed settings.json not found at $settingsPath, skipping"
    exit 0
}

Write-Host "[zed-mcp] Updating context_servers in Zed settings..."

function Remove-JsonComments {
    param([Parameter(Mandatory)][string]$Text)

    $builder = [System.Text.StringBuilder]::new()
    $inString = $false
    $escaped = $false
    $inLineComment = $false
    $inBlockComment = $false

    for ($index = 0; $index -lt $Text.Length; $index++) {
        $char = $Text[$index]

        if ($inLineComment) {
            if ($char -eq "`r" -or $char -eq "`n") {
                $inLineComment = $false
                [void]$builder.Append($char)
            }
            continue
        }

        if ($inBlockComment) {
            if ($char -eq "*" -and $index + 1 -lt $Text.Length -and $Text[$index + 1] -eq "/") {
                $inBlockComment = $false
                $index++
            }
            elseif ($char -eq "`r" -or $char -eq "`n") {
                [void]$builder.Append($char)
            }
            continue
        }

        if ($inString) {
            [void]$builder.Append($char)
            if ($escaped) {
                $escaped = $false
            }
            elseif ($char -eq "\") {
                $escaped = $true
            }
            elseif ($char -eq '"') {
                $inString = $false
            }
            continue
        }

        if ($char -eq '"') {
            $inString = $true
            [void]$builder.Append($char)
        }
        elseif ($char -eq "/" -and $index + 1 -lt $Text.Length -and $Text[$index + 1] -eq "/") {
            $inLineComment = $true
            $index++
        }
        elseif ($char -eq "/" -and $index + 1 -lt $Text.Length -and $Text[$index + 1] -eq "*") {
            $inBlockComment = $true
            $index++
        }
        else {
            [void]$builder.Append($char)
        }
    }

    $builder.ToString()
}

# Zed uses JSONC - strip comments before parsing, without changing URL strings.
$raw = Get-Content $settingsPath -Raw -Encoding UTF8
$stripped = Remove-JsonComments -Text $raw
# Strip trailing commas before } or ]
$stripped = $stripped -replace ',\s*([}\]])', '$1'

try {
    $settings = $stripped | ConvertFrom-Json
} catch {
    Write-Host "[zed-mcp] Failed to parse Zed settings.json, skipping"
    exit 0
}

# Build context_servers
$servers = [ordered]@{}
$legacyManagedServerNames = @(
    "context7",
    "plane",
    "github",
    "tavily",
    "exa",
    "firecrawl",
    "drawio",
    "cloud-run",
    "kaggle"
)

{{- if and (hasKey . "mcp_toolkit") (has "zed" .mcp_toolkit.supports) }}
$servers["{{ .mcp_toolkit.server_name }}"] = [ordered]@{
    source = "custom"
    command = "docker"
    args = @("mcp", "gateway", "run", "--profile", "{{ .mcp_toolkit.profile }}")
}
{{- end }}

{{ range .mcp_servers }}
{{- if has "zed" .supports }}
{{- if and (hasKey . "url") (not (hasKey . "command")) }}
$servers["{{ .name }}"] = [ordered]@{
    source = "custom"
    command = "npx"
    args = @("-y", "mcp-remote", "{{ .url }}")
}
{{- else }}
$servers["{{ .name }}"] = [ordered]@{
    source = "custom"
    command = "{{ .command }}"
    args = @({{ range .args }}"{{ . }}", {{ end }}$null) | Where-Object { $_ }
}
{{- if hasKey . "env" }}
$servers["{{ .name }}"]["env"] = @{
{{- range $key, $value := .env }}
    "{{ $key }}" = '{{ $value }}'
{{- end }}
}
{{- end }}
{{- end }}
{{- end }}
{{ end }}

# Merge context_servers into settings
if (-not ($settings.PSObject.Properties.Name -contains "context_servers")) {
    $settings | Add-Member -NotePropertyName "context_servers" -NotePropertyValue ([PSCustomObject]@{})
}

# Remove entries previously managed by this template before rebuilding the
# current managed set. This drops servers moved to Docker MCP Toolkit.
foreach ($name in $legacyManagedServerNames) {
    if ($settings.context_servers.PSObject.Properties.Name -contains $name) {
        $settings.context_servers.PSObject.Properties.Remove($name)
    }
}

foreach ($name in $servers.Keys) {
    if ($settings.context_servers.PSObject.Properties.Name -contains $name) {
        $settings.context_servers.$name = [PSCustomObject]$servers[$name]
    } else {
        $settings.context_servers | Add-Member -NotePropertyName $name -NotePropertyValue ([PSCustomObject]$servers[$name])
    }
}

# Write back as JSON (comments will be lost - this is a known limitation)
# Set-Content -Encoding UTF8 prepends a BOM on PowerShell 5.1, which Zed's
# serde_json parser rejects ("expected value at line 1 column 1") so all
# user settings stop loading. Use WriteAllText with a BOM-less UTF8Encoding
# to stay compatible with both PowerShell 5.1 and 7.
$json = $settings | ConvertTo-Json -Depth 20
[System.IO.File]::WriteAllText($settingsPath, $json, [System.Text.UTF8Encoding]::new($false))
Write-Host "[zed-mcp] Updated $($servers.Count) context servers in $settingsPath"
Write-Host "[zed-mcp] Note: JSONC comments were removed during merge"
{{- end }}
