# Directories deployed via .chezmoiscripts/run_onchange_*
shells/
secret/
git/
cli/
terminals/
github/
ssh/

# Documentation files (not deployed to home)
README.md
**/AGENTS.md
**/AGENTS.override.md

# Neovim の設定は Home Manager が管理する。
.config/nvim/

# OS-specific scripts (patterns match target names, not source names)
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/**/*_darwin.sh
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/**/*_linux.sh
{{ end }}
{{ if ne .chezmoi.os "windows" }}
# Native terminal configuration belongs to Home Manager.
.config/ghostty/
.config/wezterm/
.local/bin/wezterm-launch.cmd
.chezmoiscripts/**/*_windows.ps1
.glzr/
{{ end }}
